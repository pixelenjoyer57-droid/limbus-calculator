{
  "name": "limbus-calculator",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "description": "Sinner's Workshop: a Limbus Company damage calculator and combat simulator for testing custom Identities, E.G.O, enemies, encounters, events and E.G.O Gifts.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gamedata": "vite-node scripts/gamedata/build.ts --"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "immer": "11.2.10",
    "lz-string": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
