    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "immer": "10.1.1",
    "lz-string": "1.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
